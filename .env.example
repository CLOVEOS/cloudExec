# ── Copy to .env (root, for docker compose) or server/.env (for `npm start`) ──

# Sarvam AI – https://dashboard.sarvam.ai  (header: api-subscription-key)
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_MAX_TOKENS=8192
# low | medium | high | none | default  (sarvam-105b reasons before answering)
SARVAM_REASONING_EFFORT=none
SARVAM_TIMEOUT_MS=120000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated e-mails that become admins on sign-up (unlocks the Platform tab)
ADMIN_EMAILS=you@example.com

# Storage / messaging (defaults shown are for running the server outside docker)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cloudexec
USE_KAFKA=false
KAFKA_BROKERS=localhost:9092
KAFKA_PARTITIONS=6

# Sandbox limits
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5

# Rate limits (per user per minute)
RATE_LIMIT_COMPILE_PER_MIN=30
RATE_LIMIT_AI_PER_MIN=10

# ── Production deploy (docker-compose.prod.yml) ──
# Your domain, or a free one from your VM's public IP: 203-0-113-10.sslip.io
DOMAIN=
ACME_EMAIL=you@example.com
WORKER_REPLICAS=2
# gVisor sandbox runtime (installed by deploy/setup-vm.sh). Strongly recommended for a public site.
SANDBOX_RUNTIME=
